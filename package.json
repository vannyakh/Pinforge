{
  "name": "pinterest-desktop",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=desktop",
    "build": "turbo run build",
    "package": "pnpm --filter desktop run package",
    "dist": "node scripts/build-with-builder.js",
    "dist:win": "node scripts/build-with-builder.js auto --win",
    "dist:mac": "node scripts/build-with-builder.js auto --mac",
    "dist:linux": "node scripts/build-with-builder.js auto --linux",
    "dist:win:x64": "node scripts/build-with-builder.js x64 --win --x64",
    "dist:win:arm64": "node scripts/build-with-builder.js arm64 --win --arm64",
    "dist:mac:arm64": "node scripts/build-with-builder.js arm64 --mac --arm64",
    "dist:mac:x64": "node scripts/build-with-builder.js x64 --mac --x64",
    "cli": "pnpm --filter pinforge-cli start",
    "typecheck": "turbo run typecheck",
    "test": "pnpm --filter @pinterest-desktop/core test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css,md,yml}\" \"packages/**/*.{ts,tsx,js,json,md}\" \"scripts/**/*.{js,md}\" \"tests/**/*.{ts,md}\" \".github/**/*.{yml,md,yaml}\" \"*.md\" \"*.json\" \"playwright.config.ts\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,css,md,yml}\" \"packages/**/*.{ts,tsx,js,json,md}\" \"scripts/**/*.{js,md}\" \"tests/**/*.{ts,md}\" \".github/**/*.{yml,md,yaml}\" \"*.md\" \"*.json\" \"playwright.config.ts\""
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "prettier": "^3.9.6",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
