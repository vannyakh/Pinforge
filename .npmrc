# Pinforge uses pnpm. Keep installs strict and Electron downloads from defaults
# (do not set ELECTRON_MIRROR here — it can break electron-builder binary paths).
engine-strict=true
auto-install-peers=true
# Hoist so electron-builder can resolve production deps into the asar (pnpm nest otherwise drops transitive modules like conf).
shamefully-hoist=true
public-hoist-pattern[]=*
