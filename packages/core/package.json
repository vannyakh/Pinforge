{
  "name": "@pinforge/core",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./providers": "./src/providers.ts",
    "./download": "./src/download.ts",
    "./process": "./src/process.ts",
    "./preview": "./src/preview/index.ts",
    "./pipeline": "./src/pipeline.ts",
    "./engine": "./src/engine.ts",
    "./jobs": "./src/jobs.ts",
    "./hls": "./src/hls.ts",
    "./http": "./src/http.ts",
    "./storage": "./src/storage.ts",
    "./tools": "./src/tools.ts",
    "./worker": "./src/worker.ts",
    "./zip": "./src/zip/index.ts",
    "./api": "./src/api.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "tsx --test tests/unit/**/*.test.ts",
    "smoke": "tsx scripts/smoke.mts"
  },
  "dependencies": {
    "@pinforge/api": "workspace:*",
    "@pinforge/download": "workspace:*",
    "@pinforge/enhance": "workspace:*",
    "@pinforge/engine": "workspace:*",
    "@pinforge/providers": "workspace:*",
    "@pinforge/tools": "workspace:*",
    "@pinforge/types": "workspace:*",
    "@pinforge/worker": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.11",
    "typescript": "^5.7.0",
    "sharp": "^0.33.5"
  }
}
