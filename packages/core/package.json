{
  "name": "@pinterest-desktop/core",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "tsx --test tests/unit/**/*.test.ts",
    "smoke": "tsx scripts/smoke.mts",
    "playwright:install": "playwright install chromium",
    "worker:build": "cargo build -p pinforge-worker --release --manifest-path ../../rust/Cargo.toml",
    "worker:ping": "cargo run -p pinforge-worker --manifest-path ../../rust/Cargo.toml -- ping"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "playwright": "^1.62.1",
    "sharp": "^0.33.5",
    "youtubei.js": "17.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.11",
    "typescript": "^5.7.0"
  }
}
