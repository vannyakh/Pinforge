{
  "name": "desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Pinterest Downloader + Enhancer",
  "author": {
    "name": "Pinforge",
    "url": "https://github.com/vannyakh/Pinforge"
  },
  "main": "./out/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/vannyakh/Pinforge.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-builder --config electron-builder.yml --publish=never",
    "package:publish": "electron-builder --config electron-builder.yml --publish always",
    "dist": "node ../../scripts/build-with-builder.js",
    "dist:win": "node ../../scripts/build-with-builder.js auto --win",
    "dist:mac": "node ../../scripts/build-with-builder.js auto --mac",
    "dist:linux": "node ../../scripts/build-with-builder.js auto --linux",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.16",
    "@codemirror/lang-css": "^6.3.1",
    "@distube/ytdl-core": "^4.16.12",
    "@icon-park/react": "^1.4.2",
    "@pinterest-desktop/core": "workspace:*",
    "@uiw/react-codemirror": "^4.25.2",
    "classnames": "^2.5.1",
    "electron-log": "^5.4.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "playwright": "^1.62.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2",
    "semver": "^7.8.5",
    "sharp": "^0.33.5",
    "youtubei.js": "17.2.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/classnames": "^2.3.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@electron/notarize": "^2.5.0",
    "@electron/rebuild": "^3.7.1",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "prebuild-install": "^7.1.3",
    "typescript": "^5.7.0",
    "unocss": "^66.7.5",
    "unocss-preset-extra": "^1.0.0",
    "vite": "^5.4.11"
  }
}
